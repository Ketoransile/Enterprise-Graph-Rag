# Core database settings
POSTGRES_USER=graphrag_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=graphrag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://graphrag_user:change_me@postgres:5432/graphrag

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_AUTH=neo4j/change_me
NEO4J_URI=bolt://neo4j:7687

# Redis
REDIS_URL=redis://redis:6379/0

# Auth / security
JWT_SECRET=replace_me
TOKEN_EXPIRES_IN=3600
REFRESH_EXPIRES_IN=1209600
SECURITY_LEVELS=PUBLIC,INTERNAL,CONFIDENTIAL,RESTRICTED
SINGLE_TENANT=true
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# AI model provider (freemodel Responses API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.freemodel.dev
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=xhigh
OPENAI_EMBEDDINGS_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768

APP_ENV=local

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Google OAuth (backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
